{
  "mcpServers": {
    "pikpak": {
      "type": "http",
      "url": "https://pikpak.ai/mcp"
    },
    "hostinger": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "hostinger-api-mcp@2.13.0"],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    }
  }
}
